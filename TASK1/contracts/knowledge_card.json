{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Investigation Knowledge Card",
  "description": "Shared contract between Member 1 Investigation and Member 2 RCA.",
  "type": "object",
  "required": [
    "schema_version",
    "incident_id",
    "correlation_id",
    "timestamp",
    "producer",
    "consumer",
    "status",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "incident_id": {
      "type": "string"
    },
    "correlation_id": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "string",
      "const": "investigation"
    },
    "consumer": {
      "type": "string",
      "const": "rca"
    },
    "status": {
      "type": "string",
      "enum": [
        "SUCCESS",
        "PARTIAL",
        "FAILED"
      ]
    },
    "payload": {
      "type": "object",
      "required": [
        "incident",
        "findings",
        "overall_confidence"
      ],
      "properties": {
        "incident": {
          "type": "object"
        },
        "findings": {
          "type": "array"
        },
        "overall_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}